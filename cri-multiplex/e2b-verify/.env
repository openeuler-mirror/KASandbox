# e2b-verify 环境变量
#
# 凭证不写明文：E2B_API_KEY / E2B_ACCESS_TOKEN 保持空值即可，由 lib/e2b_env.sh
# 按以下优先级注入（高 -> 低）：
#   1. 已显式导出的环境变量（CI / 临时覆盖）；
#   2. ~/.config/e2b-verify/secrets.env（权限 600，仓库外文件）：
#          install -d -m 700 ~/.config/e2b-verify
#          printf 'E2B_API_KEY="%s"\nE2B_ACCESS_TOKEN="%s"\n' "$KEY" "$TOKEN" \
#              > ~/.config/e2b-verify/secrets.env
#          chmod 600 ~/.config/e2b-verify/secrets.env
#   3. /root/.e2b/config.json 中的 teamApiKey / accessToken（本机部署写入的 live 凭证，
#      最后加载并覆盖，可自动纠正过期 key）。
#
# 说明：E2B_API_URL 不可达时会自动回退到 http://127.0.0.1:3000（本机 API）。

# ---- 凭证：留空，切勿填写明文 ----
E2B_ACCESS_TOKEN=""
E2B_API_KEY=""

# ---- 非敏感配置 ----
E2B_DOMAIN="e2b.app"
E2B_API_URL="http://127.0.0.1:3000"
E2B_HTTP_SSL="false"
# 当前集群可用模板别名（逗号分隔的候选可通过 E2B_TEMPLATE_ALIAS 覆盖）
E2B_TEMPLATE_ALIAS="ubuntu-22-04-custom-1"
E2B_TEAM_ID="796953d9-f645-4fd7-adfc-c04a306114c6"
