# e2b-verify 环境变量
# 说明：lib/common.sh 会优先读取 /root/.e2b/config.json 中的 live teamApiKey；
# 这里的值仅作为无 config.json 时的回退。E2B_API_URL 不可达时会自动回退到
# http://127.0.0.1:3000（本机 API）。
E2B_ACCESS_TOKEN="sk_e2b_03f750914a6c37db791bb69e1ca875e6c8502a96"
E2B_API_KEY="e2b_1ff0783e8a814e5bd52a11744408545271591706"
E2B_DOMAIN="e2b.app"
E2B_API_URL="http://127.0.0.1:3000"
E2B_HTTP_SSL="false"
# 当前集群可用模板别名（逗号分隔的候选可通过 E2B_TEMPLATE_ALIAS 覆盖）
E2B_TEMPLATE_ALIAS="ubuntu-22-04-custom-1"
E2B_TEAM_ID="796953d9-f645-4fd7-adfc-c04a306114c6"
