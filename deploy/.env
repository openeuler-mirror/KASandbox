# =============================================================================
# 1. 部署基础
# =============================================================================
export SERVER_IP=""
export DEPLOY_MODE=nomad                    # nomad 或 k8s
export ENVIRONMENT=local
export GCP_ZONE=dc1
export SERVER_IPS="$SERVER_IP"
export NUM_SERVERS=1
export ORCHESTRATOR_DIR=/home
export SANDBOX_STORAGE_BACKEND=redis        # redis / memory

# =============================================================================
# 2. 组件开关
# =============================================================================
# PostgreSQL 组件开关：true 部署内置 postgres（默认）；false 使用外部实例
export ENABLE_POSTGRES=true
# Redis 组件开关：true 部署内置 redis（默认）；false 组件降级运行（REDIS_URL 置空，SANDBOX_STORAGE_BACKEND 自动降为 memory）
export ENABLE_REDIS=true
# edge（client-proxy）组件开关：true 部署（默认）；false 跳过部署，沙箱域名路由（*.e2b.app）不可用
export ENABLE_EDGE=true
# api 组件开关：true 部署内置 api（默认）；false helm 不渲染 api Deployment/Service（API 由外部承载，仅 k8s 模式生效）
export ENABLE_API=true
# e2b-webhook 开关：true 部署，false 不部署（默认）
export ENABLE_WEBHOOK=false

# =============================================================================
# 3. 调度器与承载方式
# =============================================================================
# --- Nomad / Consul ---
export CONSUL_ACL_TOKEN=
export NOMAD_ACL_TOKEN=
export NOMAD_TOKEN=
export CONSUL_VERSION=1.21.4
export NOMAD_VERSION=1.10.4

# --- 节点池（K8S 模式） ---
export API_NODE_POOL=api
export CLICKHOUSE_NODE_POOL=api
export BUILD_NODE_POOL=api

# --- Orchestrator 承载方式 ---
# 默认容器化（nomad 模式=nomad job，k8s 模式=DaemonSet）
# 取消注释并填 systemd 时，由节点 e2b-orchestrator.service 承载
export ORCHESTRATOR_TYPE=systemd
# API 静态发现清单（ORCHESTRATOR_TYPE=systemd 时必填）：
# 格式 "nodeName1=InternalIP1,nodeName2=InternalIP2"，nodeName 必须与 K8s Node 名一致
export ORCHESTRATOR_STATIC_NODES=""

# =============================================================================
# 4. 存储
# =============================================================================
# --- PostgreSQL ---
export POSTGRES_CONNECTION_STRING="postgresql://postgres:local@$SERVER_IP:5432/mydatabase?sslmode=disable"
# k8s 模式下 API/迁移器访问 postgres 的地址（默认内置 Service；ENABLE_POSTGRES=false 时改为外部实例地址）
export POSTGRES_URL=${POSTGRES_URL:-postgres.e2b.svc.cluster.local}
export POSTGRES_DOCKER_IMAGE=postgres
export POSTGRES_PORT=5432
export POSTGRES_USER=postgres
export POSTGRES_PASSWORD=local
export POSTGRES_RESOURCES_CPU_COUNT=2000
export POSTGRES_RESOURCES_MEMORY_MB=2048
export POSTGRES_LIMITS_CPU_COUNT=4000
export POSTGRES_LIMITS_MEMORY_MB=4096

# --- Redis ---
export REDIS_URL="redis.service.consul"
export REDIS_CLUSTER_URL=""
export REDIS_PORT_NAME=redis
export REDIS_PORT=6379
export REDIS_VERSION=7.4.4-alpine
# 组件注入用的完整 Redis 地址（host:port）；ENABLE_REDIS=false 时部署脚本自动置空
export REDIS_ENDPOINT=${REDIS_ENDPOINT:-"${REDIS_URL}:${REDIS_PORT}"}

# --- MinIO ---
export MINIO_ENDPOINT="$SERVER_IP:9000"
export MINIO_ACCESS_KEY="minioadmin"
export MINIO_SECRET_KEY="minioadmin"



export TEMPLATE_BUCKET_NAME=e2b-dev-fc-templates
export BUILD_CACHE_BUCKET_NAME=e2b-dev-fc-cache

# --- 存储后端 ---
# Manual specification required for installation
export STORAGE_PROVIDER=Local
export ARTIFACTS_REGISTRY_PROVIDER=Local

# =============================================================================
# 5. Harbor 镜像仓库
# =============================================================================
export HARBOR_HTTP_PORT=2900
export HARBOR_HTTPS_PORT=30443
export HARBOR_DATA_DIR=/data  # 镜像仓库数据存储目录
export HARBOR_CERTS_DIR=/etc/harbor/certs
export REGISTRY_PROJECT=e2b-orchestration
# Harbor 固定 HTTPS-only，HARBOR_HOST 指向 HTTPS 端口（template-manager/orchestrator 推拉镜像使用）
export HARBOR_HOST=$SERVER_IP:$HARBOR_HTTPS_PORT
export HARBOR_PROJECT=e2b-orchestration
export HARBOR_USERNAME=admin
export HARBOR_PASSWORD=Harbor12345

# =============================================================================
# 6. API 服务
# =============================================================================
export API_PORT_NAME=api
export API_PORT=3000
export API_GRPC_PORT=5009
export API_GRPC_ADDRESS=localhost:5009
export API_DOCKER_IMAGE=api
export API_ADMIN_TOKEN=dev_admin
export API_RESOURCES_CPU_COUNT=2000
export API_RESOURCES_MEMORY_MB=2048
export API_LIMITS_CPU_COUNT=2000
export API_LIMITS_MEMORY_MB=4096
# 是否使用大页内存（true/false），留空则按 firecracker 版本判断（>= 1.7 开启）
# 仅影响之后新构建的模板，已有模板需重新构建才会生效
export E2B_USE_HUGE_PAGES=
# Recommended to randomly generate; used as api access token
export SANDBOX_ACCESS_TOKEN_HASH_SEED=dadbb9c5-7c79-7bb1-f58c-e0fa61d49c57

# =============================================================================
# 7. Edge / Client Proxy
# =============================================================================
export CLIENT_PROXY_COUNT=1
export CLIENT_PROXY_DOCKER_IMAGE=client-proxy
export EDGE_PROXY_PORT_NAME=session
export EDGE_PROXY_PORT=3002
export EDGE_API_PORT_NAME=edge-api
export EDGE_API_PORT=3001
export EDGE_HEALTH_PORT=3003
export EDGE_API_SECRET=dadbb9c5-7c79-7bb1-f58c-e0fa61d49c57
export CLIENT_PROXY_RESOURCES_CPU_COUNT=40000
export CLIENT_PROXY_RESOURCES_MEMORY_MB=40960
export CLIENT_PROXY_MAX_RESOURCES_MEMORY_MB=61440

# =============================================================================
# 8. Orchestrator / Template Manager
# =============================================================================
export ORCHESTRATOR_PORT_NAME=orchestrator
export ORCHESTRATOR_PORT=5008
export ORCHESTRATOR_PROXY_PORT_NAME=orchestrator-proxy
export ORCHESTRATOR_PROXY_PORT=5007
export TEMPLATE_MANAGER_PORT=5008
export TEMPLATE_MANAGER_HOST=template-manager.service.consul:5008
export TEMPLATE_MANAGER_RESOURCES_CPU_COUNT=2048
export TEMPLATE_MANAGER_RESOURCES_MEMORY_MB=8192
export TEMPLATE_MANAGER_LIMITS_CPU_COUNT=2048
export TEMPLATE_MANAGER_LIMITS_MEMORY_MB=8192
export ENVD_TIMEOUT=60s
export ALLOW_SANDBOX_INTERNET=true
export SHARED_CHUNK_CACHE_PATH=
export E2B_FC_NETNS_EXEC_HELPER=/opt/e2b-infra/bin/fc-netns-exec
export E2B_USE_FC_NETNS_EXEC_HELPER=true

# =============================================================================
# 9. Mooncake 存储后端
# =============================================================================
# 节点本机IP / 集群地址（固定节点）
export GLOG_logtostderr="1"
export MOONCAKE_MASTER_ADDR="141.61.17.196:50055"
export MOONCAKE_METADATA_SERVER="http://141.61.17.196:8015/metadata"
# 缓存 / 分片 / 协议
export MOONCAKE_LOCAL_BUFFER_SIZE="536870912"
export MOONCAKE_GLOBAL_SEGMENT_SIZE="0"
export MOONCAKE_PROTOCOL="ub"
export MC_URMA_TRANS_MODE="RM"
export MOONCAKE_DEVICE_NAME="bonding_dev_0"
# 日志
export MC_LOG_ENABLE="1"
export MC_LOG_DIR="/orchestrator"
export MC_LOG_LEVEL="TRACE"
# 本地热缓存
export MC_STORE_LOCAL_HOT_CACHE_USE_SHM="0"
export MC_STORE_LOCAL_HOT_BLOCK_SIZE="67108864"
export MC_STORE_LOCAL_HOT_ADMISSION_THRESHOLD="1"
# 分片与工作线程
export MC_SLICE_SIZE="1048576"
export MC_WORKERS_PER_CTX="8"
export MC_MAX_WR="4"
# URMA bonding / NUMA 亲和
export MC_URMA_BONDING_MULTIPATH_ENABLE="on"
export MC_UB_NUMA_AFFINITY_ENABLE="on"
# 层文件（COPY）上传：CLI 直连 template-manager 的 HTTP 通道
export MOONCAKE_UPLOAD_PUBLIC_ENDPOINT="http://$SERVER_IP:5008"
export MOONCAKE_UPLOAD_SIGNING_SECRET=""        # 多副本共享同一入口时必须显式配置且各节点一致
export MOONCAKE_UPLOAD_MAX_BYTES=""             # 默认 10GiB

