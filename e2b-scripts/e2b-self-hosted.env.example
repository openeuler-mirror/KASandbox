# Copy this file to .env in the repository root before first use.
# Do not commit the completed .env file.

# Required: Team API Key from your E2B self-hosted deployment.
E2B_API_KEY=replace_with_your_team_api_key

# Optional when this script runs on the E2B API node.
# Default: http://127.0.0.1:3000
# Set it when the script runs on another machine.
# E2B_API_URL=http://api.example.com:3000

# The three values below are optional. Default sandbox routing uses the API host,
# its URL scheme, and client-proxy port 3002. Set them only for a separate route.
# E2B_DOMAIN=sandbox.example.com
# E2B_HTTP_SSL=true
# E2B_PROXY_PORT=3002

# Optional: needed only by older template-manager deployments.
# E2B_ACCESS_TOKEN=replace_with_your_access_token

# Optional override for `bash start.sh test-e2e --all`.
# The runner discovers an image from Template metadata or local deployment files first.
# Set this only when automatic discovery cannot find the image you want to validate.
# E2B_E2E_BASE_IMAGE=<registry>/<project>/ubuntu:22.04-custom

# Optional: set only when the deployment provides one fixed data-plane endpoint.
# E2B_SANDBOX_URL=http://sandbox-proxy.example.com:3002
