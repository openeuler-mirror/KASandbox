# webhook-verify 配置样例
#
#   cp .env.example .env      # 按需改；.env 会被 lib/common.sh 自动 source
#
# 全部变量都有默认值，通常只需要改 WV_E2E_TEMPLATE 或 WV_MOCK_HOST。

# ---- 集群 / 部署对象 ----
# KUBECONFIG=~/.kube/config
# WV_NAMESPACE=e2b
# WV_DEPLOYMENT=e2b-webhook
# WV_CONTAINER=e2b-webhook
# WV_SERVICE=e2b-webhook
# WV_MWC=e2b-webhook
# WV_TLS_SECRET=e2b-webhook-tls
# WV_APIKEY_SECRET=e2b-api-key

# ---- 镜像 ----
# 不设则按 REGISTRY_URL → deploy/.env → 集群运行中镜像反推。
# WV_IMAGE_REPO=193.12.7.2:30443/e2b-orchestration/e2b-webhook
# WV_IMAGE_TAG=verify-20260101-120000-abcdef0

# ---- 测试资源 ----
# WV_TEST_NS=webhook-verify
# WV_PORT=18443                 # 本地 port-forward 端口（不是 webhook 的 8443）
# WV_POD_LABEL=batch-sandbox.sandbox.opensandbox.io/pod-index

# ---- mock API ----
# webhook 在集群内访问 mock，因此 mock host 必须是节点/Pod 可达的地址；
# 留空则自动取第一个节点的 InternalIP。
# WV_MOCK_HOST=193.12.7.2
# WV_MOCK_PORT=18080
# 控制面固定用 WV_MOCK_PORT+1（默认 18081），只在本机访问：
# 测试脚本通过 POST /mode 在运行时切换 mock 行为（status/body/delay/size/refuse），
# 因此整个模块只需要切换一次 E2B_API_URL，不必逐条用例滚动 Deployment。

# ---- 端到端（04） ----
# WV_E2E=1
# WV_E2E_TIMEOUT=300
# WV_E2E_TEMPLATE=ubuntu-22-04-custom-1
# WV_E2E_IMAGE=                 # 留空则按 /templates 自动解析 e2b.dev/<templateID>:<buildID>
# WV_E2E_POD=webhook-e2e-sandbox
# WV_CRI_SOCKET=/run/cri-multiplex.sock
# WV_ORCHESTRATOR=localhost:5008
# WV_E2E_BATCHSANDBOX=0         # 对应 --e2e-batchsandbox
# WV_E2E_ADVANCED=0             # 对应 --e2e-advanced

# ---- SDK（E8，含 pause/resume） ----
# WV_SDK=1
# WV_SDK_TIMEOUT=300
# WV_SDK_API_URL=               # 留空按顺序探测：WV_SDK_API_URL → E2B_API_URL → svc/api ClusterIP → localhost:3000
# WV_E2B_CONFIG=/root/.e2b/config.json
# E2B_API_KEY=                  # 留空则读 WV_E2B_CONFIG 的 teamApiKey / k8s Secret

# ---- 行为开关 ----
# WV_RESTORE_ON_EXIT=1          # 退出时回滚镜像/副本/.env
# WV_KEEP=0                     # 保留现场与镜像
# WV_STRICT=0                   # 已知差异 SKIP → FAIL
# WV_UNIT=1                     # 00 里跑 go vet/build/test
# WV_PROVIDER=e2b               # 当前验证的后端（见 lib/provider.sh:PROVIDER_TABLE）

# ---- 探针镜像（mock 可达性、envd 健康检查用） ----
# 留空则用 <registry>/busybox:latest，再兜底 busybox:latest。
# WV_PROBE_IMAGE=193.12.7.2:30443/e2b-orchestration/busybox:latest
